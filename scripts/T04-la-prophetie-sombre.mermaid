flowchart TD
    classDef start-node fill:#fff,stroke:#333,color:#000,stroke-width:5px;
    classDef finish-node fill:#fff,stroke:#333,color:#000,stroke-width:5px;
    classDef question-node fill:#00f,stroke:#333,color:#fff,stroke-width:2px;
    classDef solution-node fill:#0f0,stroke:#333,color:#000,stroke-width:2px;
    classDef fight-node fill:#f96,stroke:#333,stroke-width:2px;
    classDef savepoint-node fill:#fff,stroke:#333,color:#000,stroke-width:2px,stroke-dasharray: 5 5;
    classDef check-node fill:#ff0,stroke:#333,color:#000,stroke-width:2px;
    classDef tome-node fill:#ccc,stroke:#333,color:#000,stroke-width:2px;
    classDef royaume-des-ombres-node fill:#666,stroke:#333,color:#fff,stroke-width:2px;
    classDef required-royaume-des-ombres-node fill:#666,stroke:#333,color:#fff,stroke-width:2px,stroke-dasharray: 5 5;
    classDef royaume-des-ombres-localisation-node fill:#fff,stroke:#333,color:#000,stroke-width:5px;
    classDef goutte-du-temps-node fill:#0ff,stroke:#333,color:#000,stroke-width:2px;
    classDef royaume-des-ombres-secret-node fill:#666,stroke:#333,color:#fff,stroke-width:2px;

    subgraph mermaid-legend["📋 LÉGENDE"]
        L1:::start-node@{shape: circle}
        L1 --> L1t["Start"]
        L2:::finish-node@{shape: dbl-circ}
        L2 --> L2t["End"]
        L3:::question-node@{shape: hex}
        L3 --> L3t["Enigme"]
        L4:::fight-node@{shape: bang}
        L4 --> L4t["Combat"]
        L5:::savepoint-node@{shape: cylinder}
        L5 --> L5t["Point de sauvegarde"]
        L6:::check-node@{shape: rect}
        L6 --> L6t["Checkbox"]
        L7:::royaume-des-ombres-node@{shape: card}
        L7 --> L7t["Lien vers une extension"]
        L8:::royaume-des-ombres-secret-node@{shape: card}
        L8 --> L8t["Royaume des Ombres - passage secret"]
    end

